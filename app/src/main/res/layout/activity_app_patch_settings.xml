<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/speed_bg_dark"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/speed_card_dark"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/patch_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Application Patches"
            android:textColor="@color/speed_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Configure active hooks and bytecode modifications"
            android:textColor="@color/speed_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/app_patch_settings_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/speed_bg_dark" />

</LinearLayout>
