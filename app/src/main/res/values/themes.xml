<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="MainTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="p">false</item>
        <item name="android:colorAccent">@color/speed_accent</item>
        <item name="android:colorPrimary">@color/speed_primary</item>
        <item name="android:colorPrimaryDark">@color/speed_primary_dark</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:windowBackground">@color/speed_bg_dark</item>
        <item name="android:navigationBarColor">@color/speed_bg_dark</item>
        <item name="android:statusBarColor">@color/speed_card_dark</item>

        <item name="android:textColorPrimary">@color/speed_text_primary</item>
        <item name="android:textColorSecondary">@color/speed_text_secondary</item>
    </style>

    <style name="ListDividerNull">
        <item name="android:listDivider">@null</item>
    </style>

    <style name="SettingsTheme" parent="MainTheme">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:singleLineTitle">false</item>
        <item name="android:windowBackground">@color/speed_bg_dark</item>
        <item name="android:colorAccent">@color/speed_accent</item>
        <item name="android:listDivider">@null</item>
    </style>

</resources>
